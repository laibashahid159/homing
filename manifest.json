{
  "manifest_version": 3,
  "name": "Homebase — Arc-style sidebar",
  "short_name": "Homebase",
  "version": "0.3.0",
  "description": "An Arc-style sidebar for Chrome: a Favorites grid, pinned tabs with folders that remember their home URL, and your open tabs.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "contextMenus",
    "favicon",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Open Homebase",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "pin-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pin the current tab to Homebase"
    },
    "reset-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Send the current pinned tab back to its home URL"
    }
  }
}
